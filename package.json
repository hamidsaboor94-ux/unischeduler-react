{
  "name": "unischeduler-react",
  "productName": "UniScheduler",
  "description": "University course, timetable, and exam scheduling desktop app",
  "author": "LEMON_Soft",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "icon": "node scripts/make-icon.mjs",
    "electron": "npm run build && node scripts/copy-backend.mjs && electron .",
    "electron:dev": "node scripts/copy-backend.mjs && electron .",
    "dist": "npm run build && node scripts/copy-backend.mjs && electron-builder --win",
    "release": "npm run build && node scripts/copy-backend.mjs && electron-builder --win --publish always",
    "ship": "node scripts/ship.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "electron-updater": "^6.8.9",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "i18next": "^26.3.6",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.10",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  },
  "build": {
    "appId": "com.lemonsoft.unischeduler",
    "productName": "UniScheduler",
    "publish": [
      {
        "provider": "github",
        "owner": "hamidsaboor94-ux",
        "repo": "unischeduler-releases"
      }
    ],
    "directories": {
      "output": "C:/UniScheduler-release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/pdfjs-dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "UniScheduler"
    }
  }
}
